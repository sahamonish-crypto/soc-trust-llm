{
  "artifact": "GATE6D_SECONDARY_UNCERTAINTY_SENSITIVITY_PROTOCOL_V1",
  "status": "FROZEN_PROSPECTIVE_SECONDARY_PROTOCOL",
  "freeze_date": "2026-11-03",

  "role": {
    "analysis_type": "SECONDARY_ONLY",
    "primary_method_selection_changed": false,
