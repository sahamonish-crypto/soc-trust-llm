      ],
      "can_change_primary_winner": false
    }
  },

  "primary_selection_governance": {
    "frozen_primary_metric": "grouped OOF Brier",
    "frozen_brier_effective_tie_threshold": 0.01,
    "frozen_first_tiebreak": "better AUROC correctness",
