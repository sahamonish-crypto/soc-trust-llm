    "significance_testing_used_to_override_winner": false,
    "purpose": [
      "quantify uncertainty around frozen out-of-fold performance estimates",
      "assess robustness to episode clustering",
      "assess capture, ground-truth-class, and episode influence",
      "provide publication-quality uncertainty reporting"
    ]
  },

  "dev_structure": {
    "alert_rows_nested_within_episode": true,
    "episode_group_key": [
      "capture",
      "episode_start_utc"
    ],
    "frozen_dev_episode_groups": 48,
    "capture_strata": [
      "AmazonEcho-2023-02-21",
      "Windows7AD-2023-02-21"
    ],
    "capture_treated_as_fixed_stratum": true,
    "capture_resampled_as_independent_cluster": false
  },

  "bootstrap": {
    "name": "CAPTURE_STRATIFIED_EPISODE_CLUSTER_PERCENTILE_BOOTSTRAP",
    "resampling_unit": "episode",
    "group_key": [
      "capture",
      "episode_start_utc"
    ],
    "stratify_by_capture": true,
    "within_each_capture": {
      "sample_episode_clusters_with_replacement": true,
      "number_of_drawn_clusters_equals_original_cluster_count": true,
      "carry_all_rows_from_drawn_episode": true,
      "preserve_cluster_multiplicity": true
    },
    "row_level_bootstrap_permitted": false,

    "bootstrap_replicates": 10000,
    "confidence_level": 0.95,
    "confidence_interval": "percentile",
    "lower_quantile": 0.025,
    "upper_quantile": 0.975,
    "quantile_interpolation_method": "linear",

    "seed_namespace": "GATE6D_SECONDARY_BOOTSTRAP_V1",
    "seed_sha256": "bc9ed85d9834fe9da0849c7c6f19f4e202eba21b59ab510b51e1ae0510ca04b6",
    "seed_derivation": "SHA256 UTF-8 namespace; first 8 bytes unsigned big-endian; clear sign bit to uint63; replace zero with one",
    "seed_uint63": 4368166585093127837,

    "same_episode_draws_reused_across_candidate_methods": true,
    "same_episode_draws_reused_across_paired_differences": true,

    "undefined_metric_replicate": {
      "redraw_permitted": false,
      "stored_as": "undefined",
      "minimum_valid_fraction_for_ci": 0.95,
      "minimum_valid_replicates_when_B_10000": 9500,
      "below_threshold": "CI_UNAVAILABLE_WITH_REASON"
    }
  },

  "bootstrap_estimand": {
    "point_predictions": "frozen grouped-OOF probabilities produced by the frozen calibration-analysis core",
    "calibrator_refit_inside_bootstrap": false,
    "estimator_refit_inside_bootstrap": false,
    "interpretation": "conditional cluster-bootstrap uncertainty of the realized grouped-OOF predictions",
    "not_interpreted_as": [
      "full model-training uncertainty",
      "new cross-validation procedure",
      "alternative winner-selection procedure"
    ]
  },

  "metrics": {
    "brier": {
      "target": "prediction correctness",
      "direction": "lower_is_better",
      "bootstrap_ci": true
    },
    "auroc_correct": {
      "positive_class": "correct recommendation",
      "direction": "higher_is_better",
      "bootstrap_ci": true,
      "undefined_if_resample_has_one_correctness_class": true
    },
    "auprc_incorrect": {
      "positive_class": "incorrect recommendation",
      "score": "1 - calibrated probability of correctness",
      "direction": "higher_failure_discrimination_is_better",
      "bootstrap_ci": true,
      "undefined_if_resample_has_no_incorrect_items": true
    },
    "ece10": {
      "bins": 10,
      "binning": "same frozen fixed equal-width bins",
      "direction": "lower_is_better",
      "bootstrap_ci": true
    },
    "reliability_diagram": {
      "same_frozen_10_bins": true,
      "point_estimate_required": true,
      "bootstrap_binwise_ci_required": false
    }
  },

  "candidate_reporting": {
    "all_valid_frozen_candidate_rows_receive_ci": true,
    "invalid_candidate_rows_remain_invalid": true,
    "bootstrap_may_not_make_invalid_candidate_valid": true,
    "constant_oof_baseline_receives_secondary_uncertainty_summary": true
  },

  "paired_estimator_sensitivity": {
    "population": "frozen paired-common-valid DEV population",
    "pairing_unit": "same bootstrap episode draw",
    "difference_definition": "metric(VC_SELF_EVAL) - metric(SC5_AGREEMENT)",
    "comparisons": [
